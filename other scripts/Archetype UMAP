# =============================
# UMAP FeaturePlots for k=5 archetype weights
# =============================
suppressPackageStartupMessages({
  library(Seurat)
  library(ggplot2)
})

# -----------------------------
# 1) Extract k=5 weights (cells x 5) and add to Seurat metadata
# -----------------------------
cell_ids <- colnames(combined_no_IA)

W5 <- pcha_extract_weights_S(fit_k5, cell_ids = cell_ids, prefix = "A")

# No prefix (panels will be A1..A5)
feat_names <- colnames(W5)  # "A1" ... "A5"

# Add each archetype weight as a Seurat meta column
for (j in seq_len(ncol(W5))) {
  combined_no_IA[[feat_names[j]]] <- W5[, j]
}

# -----------------------------
# 2) Sanity: confirm UMAP exists
# -----------------------------
if (!("umap" %in% names(combined_no_IA@reductions))) {
  stop("Seurat object has no UMAP reduction named 'umap'. Run RunUMAP() first or set reduction= to the correct name.", call. = FALSE)
}

# -----------------------------
# 3) Plot: 5-panel UMAP (FeaturePlot-like)
# -----------------------------
p_A_umap <- FeaturePlot(
  object = combined_no_IA,
  features = feat_names,
  reduction = "umap",
  ncol = 3,
  pt.size = 0.2,
  order = TRUE
)


# -----------------------------
# 4) Save as PNG
# -----------------------------
ggsave(
  filename = "UMAP_archetype_weights_k5.png",
  plot = p_A_umap,
  width = 10,
  height = 7,
  dpi = 300
)

print(p_A_umap)
