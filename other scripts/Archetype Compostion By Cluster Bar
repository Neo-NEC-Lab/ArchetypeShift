# =============================
# Archetype composition by cluster (weighted) — replicate-aware (PACKAGE)
# =============================
plot_archetype_composition_by_cluster <- function(
    obj,
    weight_cols,
    cluster_col,
    group_col,
    sample_col,
    group_levels = NULL,
    cluster_order = NULL,
    reverse_cluster_order = TRUE,
    fill_palette = NULL,
    normalize = c("within_group_cluster", "none"),
    title = "Archetype composition per cluster (weighted)",
    out_png = NULL,
    width = 9,
    height = 5,
    dpi = 300,
    min_cells = 10L,
    return_data = TRUE
) {
  # -----------------------------
  # [CHECKS] inputs + dependencies
  # -----------------------------
  if (!methods::is(obj, "Seurat")) stop("`obj` must be a Seurat object.", call. = FALSE)
  md <- obj@meta.data

  if (!is.character(weight_cols) || length(weight_cols) < 2L) stop("`weight_cols` must have length >= 2.", call. = FALSE)
  if (!all(weight_cols %in% colnames(md))) stop("Some `weight_cols` are missing in obj@meta.data.", call. = FALSE)

  for (nm in c("cluster_col", "group_col", "sample_col")) {
    val <- get(nm, inherits = FALSE)
    if (!is.character(val) || length(val) != 1L || is.na(val) || !nzchar(val)) stop(paste0("`", nm, "` must be a single string."), call. = FALSE)
    if (!val %in% colnames(md)) stop(paste0("`", nm, "` not found in obj@meta.data: ", val), call. = FALSE)
  }

  normalize <- match.arg(normalize)

  if (!is.null(group_levels)) {
    if (!is.character(group_levels) || length(group_levels) < 1L) stop("`group_levels` must be a character vector or NULL.", call. = FALSE)
  }
  if (!is.null(cluster_order)) {
    if (!is.character(cluster_order) || length(cluster_order) < 1L) stop("`cluster_order` must be a character vector or NULL.", call. = FALSE)
  }
  if (!is.logical(reverse_cluster_order) || length(reverse_cluster_order) != 1L) stop("`reverse_cluster_order` must be TRUE/FALSE.", call. = FALSE)

  if (!is.null(out_png)) {
    if (!is.character(out_png) || length(out_png) != 1L || is.na(out_png) || !nzchar(out_png)) stop("`out_png` must be a single file path or NULL.", call. = FALSE)
  }

  if (!requireNamespace("dplyr", quietly = TRUE)) stop("Package 'dplyr' is required.", call. = FALSE)
  if (!requireNamespace("tidyr", quietly = TRUE)) stop("Package 'tidyr' is required.", call. = FALSE)
  if (!requireNamespace("ggplot2", quietly = TRUE)) stop("Package 'ggplot2' is required.", call. = FALSE)

  # -----------------------------
  # [COMPUTE] replicate-aware occupancy (sample × group × cluster)
  # -----------------------------
  occ <- compute_occupancy(
    obj = obj,
    weight_cols = weight_cols,
    sample_col = sample_col,
    group_col = group_col,
    cluster_col = cluster_col,
    threshold = NULL,
    min_cells = min_cells
  )

  d <- occ$sample_cluster_occ
  if (is.null(d) || nrow(d) == 0L) stop("No rows in sample_cluster_occ. Check inputs/min_cells.", call. = FALSE)

  # Standardize column names for internal use
  d <- d[, c(sample_col, group_col, cluster_col, weight_cols), drop = FALSE]
  colnames(d)[1:3] <- c("sample", "group", "cluster")
  d$group <- as.character(d$group)
  d$cluster <- as.character(d$cluster)

  # Optional group order/filter
  if (!is.null(group_levels)) {
    d <- d[d$group %in% group_levels, , drop = FALSE]
    d$group <- factor(d$group, levels = group_levels)
  } else {
    d$group <- factor(d$group, levels = unique(d$group))
  }

  # -----------------------------
  # [AGGREGATE] mean across samples within each group×cluster
  # -----------------------------
  d_long <- d %>%
    tidyr::pivot_longer(dplyr::all_of(weight_cols), names_to = "archetype", values_to = "occ") %>%
    dplyr::group_by(group, cluster, archetype) %>%
    dplyr::summarise(mean_occ = mean(occ, na.rm = TRUE), .groups = "drop")

  # Optional normalization within each group×cluster so stacks sum to 1
  if (normalize == "within_group_cluster") {
    d_long <- d_long %>%
      dplyr::group_by(group, cluster) %>%
      dplyr::mutate(value = mean_occ / sum(mean_occ, na.rm = TRUE)) %>%
      dplyr::ungroup()
    x_lab <- "Fraction of Archetype Weight"
    x_lim <- c(0, 1)
  } else {
    d_long$value <- d_long$mean_occ
    x_lab <- "Mean archetype weight (per-sample mean, then averaged)"
    x_lim <- NULL
  }

  # -----------------------------
  # [ORDER] clusters + archetypes
  # -----------------------------
  if (!is.null(cluster_order)) {
    d_long <- d_long[d_long$cluster %in% cluster_order, , drop = FALSE]
    levs <- cluster_order
    if (reverse_cluster_order) levs <- rev(levs)
    d_long$cluster <- factor(d_long$cluster, levels = levs)
  } else {
    levs <- sort(unique(as.character(d_long$cluster)))
    if (reverse_cluster_order) levs <- rev(levs)
    d_long$cluster <- factor(as.character(d_long$cluster), levels = levs)
  }

  d_long$archetype <- factor(d_long$archetype, levels = weight_cols)

  # -----------------------------
  # [PLOT]
  # -----------------------------
  p <- ggplot2::ggplot(d_long, ggplot2::aes(x = value, y = cluster, fill = archetype)) +
    ggplot2::geom_col(width = 0.75) +
    ggplot2::facet_wrap(~ group, ncol = 1, scales = "free_y") +
    ggplot2::labs(
      title = title,
      x = x_lab,
      y = NULL,
      fill = "Archetype"
    ) +
    ggplot2::theme_classic() +
    ggplot2::theme(
      plot.title = ggplot2::element_text(face = "bold"),
      panel.border = ggplot2::element_rect(color = "black", fill = NA, linewidth = 0.6),
      panel.grid.major = ggplot2::element_line(color = "grey92", linewidth = 0.18),
      panel.grid.minor = ggplot2::element_blank(),
      strip.background = ggplot2::element_blank(),
      strip.text = ggplot2::element_text(face = "bold"),
      legend.position = "right"
    )

  if (!is.null(x_lim)) {
    p <- p + ggplot2::scale_x_continuous(limits = x_lim, expand = c(0, 0))
  }

  if (!is.null(fill_palette)) {
    if (!is.character(fill_palette) || length(fill_palette) != length(weight_cols)) {
      stop("`fill_palette` must be a character vector of colors with length equal to weight_cols.", call. = FALSE)
    }
    p <- p + ggplot2::scale_fill_manual(values = fill_palette)
  }

  # -----------------------------
  # [SAVE] PNG (default)
  # -----------------------------
  if (!is.null(out_png)) {
    ggplot2::ggsave(filename = out_png, plot = p, width = width, height = height, dpi = dpi, units = "in")
  }

  if (isTRUE(return_data)) {
    return(list(plot = p, data = d_long))
  }
  p
}

