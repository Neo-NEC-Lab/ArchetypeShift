  group_col = "condition2",
  sample_col = "orig.ident",
  group_levels = c("NEC", "NEC_HA"),
  cluster_order = c(
    "Stem","Best 4+","Cycling TA (G2/M)","Cycling TA (S Phase) 1","Cycling TA (S Phase) 2",
    "Secretory TA","Secretory Progenitor","Immature AE","AE Progenitor","Mature Secretory",
    "Mature AE 2","Mature AE 1"
  ),
  reverse_cluster_order = FALSE,
  normalize = "within_group_cluster",
  title = "Archetype Composition Per Cluster",
  out_png = "archetype_composition_by_cluster_weighted.png",
  width = 10,
  height = 6,
  dpi = 300,
  min_cells = 10L,
  return_data = TRUE
)
